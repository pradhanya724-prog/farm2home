SECRET_KEY=replace-with-a-long-random-secret
# Local development uses SQLite automatically when DATABASE_URL is empty.
# For Amazon RDS MySQL:
DATABASE_URL=mysql+pymysql://DB_USER:DB_PASSWORD@RDS_ENDPOINT:3306/farm2home
AWS_REGION=ap-south-1
S3_BUCKET=
SNS_TOPIC_ARN=
# Set to true only after creating the bucket and SNS topic and configuring IAM permissions.
ENABLE_AWS=false
